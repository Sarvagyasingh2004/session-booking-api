    "express": "^4.22.3",
    "mongoose": "^9.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
